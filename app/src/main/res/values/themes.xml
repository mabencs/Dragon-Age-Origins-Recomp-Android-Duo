<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, no action bar, black background.

         windowBackground matters more than it looks: it is what the compositor shows
         between the activity appearing and the first Vulkan present. Left at the
         default it is a white flash on every launch. -->
    <style name="Theme.Warden" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/warden_iron</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
