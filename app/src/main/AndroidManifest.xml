<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan 1.1 is the floor Xenia's GPU emulation needs; the Thor reports 1.3.128.
         Declared as required so the app cannot be installed somewhere it cannot run. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="1"
        android:required="true" />

    <!-- A controller is how this is played, but not having one must not block install:
         the handheld's built-in pad is reported as a gamepad source anyway, and
         touch-only use is still useful for the extraction and settings screens. -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- PLAN 12.5: making the game's code on the device (GameCodeService) - about ten
         minutes, in the foreground so it goes on with the app put away, the CPU held
         awake with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- PLAN 13.1: the launcher's update check and its download (AppUpdate), the app's
         only network use; the game itself stays offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Warden">

        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:launchMode="singleTask"
            android:screenOrientation="userLandscape"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:colorMode="wideColorGamut"
            android:theme="@style/Theme.Warden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|layoutDirection|touchscreen|locale|fontScale">

            <!-- Every one of those configChanges is deliberate. Without them Android
                 destroys and recreates the activity, which destroys the Surface, which
                 means tearing down and rebuilding the Vulkan swapchain - and in the
                 worst case losing the device - for something as ordinary as plugging in
                 a controller (keyboard/navigation) or the system changing theme.
                 Handling these in-process is cheaper and far less fragile. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- PLAN 8: the second screen's deck, in its own process (8.7: its failure or
             a hang ends it, never the game), on the second display by
             ActivityOptions.setLaunchDisplayId. Resizeable, as a window on another
             display must be; never focused (its window's own flag). -->
        <activity
            android:name=".DeckActivity"
            android:process=":deck"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.deck"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Warden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|touchscreen|fontScale" />

        <!-- The deck's window onto the game: in the game's process, answering on its
             binder threads. -->
        <service
            android:name=".DeckService"
            android:exported="false" />

        <!-- PLAN 12.5: the game's code made from the player's disc, in a process of its
             own: the compiler's runs and their memory stay out of the app's. -->
        <service
            android:name=".GameCodeService"
            android:process=":gamecode"
            android:exported="false" />
    </application>

</manifest>
